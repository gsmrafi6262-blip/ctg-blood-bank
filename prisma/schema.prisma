generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }
model Profile { id String @id @db.Uuid displayName String? @map("display_name") phone String? role String @default("user") createdAt DateTime @default(now()) @map("created_at") @@map("profiles") }
model Donor { id String @id @default(uuid()) @db.Uuid userId String? @map("user_id") @db.Uuid fullName String @map("full_name") phone String dateOfBirth DateTime? @map("date_of_birth") @db.Date gender String? bloodGroup String @map("blood_group") district String upazila String? consent Boolean @default(false) status String @default("pending") createdAt DateTime @default(now()) @map("created_at") @@map("donors") }
model BloodRequest { id String @id @default(uuid()) @db.Uuid requesterUserId String? @map("requester_user_id") @db.Uuid patientName String @map("patient_name") phone String bloodGroup String @map("blood_group") units Int hospitalName String? @map("hospital_name") district String? neededBy DateTime? @map("needed_by") urgency String @default("normal") status String @default("pending") createdAt DateTime @default(now()) @map("created_at") @@map("blood_requests") }
model BloodUnit { id String @id @default(uuid()) @db.Uuid bloodGroup String @map("blood_group") component String @default("Whole blood") quantity Int @default(1) expiresAt DateTime? @map("expires_at") @db.Date location String? status String @default("quarantine") createdAt DateTime @default(now()) @map("created_at") @@map("blood_units") }
model WorkflowRecord { id String @id @default(uuid()) @db.Uuid module String reference String details String? status String @default("pending") createdBy String? @map("created_by") @db.Uuid createdAt DateTime @default(now()) @map("created_at") @@map("workflow_records") }
